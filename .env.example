# Price Hunter — variables d'environnement
# Copier ce fichier vers .env et remplir. NE JAMAIS comettre de vraise clé.

# --- Base de données (locale: docker compose up -d) ---
DATABASE_URL=postgresql://pricehunter:pricehunter@localhost:5432/pricehunter

# --- Session (générer : openssl rand -hex 32) ---
SESSION_SECRET=

# --- eBay Browse API (gratuite) : developer.ebay.com ---
# Créer une app, puis récupérer App ID (Client ID) et Cert ID (Client Secret).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_FR

# --- E2E Playwright ---
E2E_BASE_URL=http://localhost:3000
E2E_QUERY=Sony WH-1000XM5
